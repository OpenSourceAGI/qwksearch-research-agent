# Vercel ignore file for extract-pdf site deployment
# Exclude unnecessary files and directories

# Node modules
**/node_modules/**
**/.bun/**

# Build outputs
**/dist/**
**/build/**
**/.next/**
**/.vercel/**

# IDE files
**/.vscode/**
**/.idea/**
*.swp
*.swo

# OS files
**/.DS_Store
**/Thumbs.db

# Git
**/.git/**
**/.gitignore

# Logs
*.log
**/npm-debug.log*

# Test files
**/test/**
**/tests/**
**/*.test.ts
**/*.spec.ts
**/coverage/**

# Documentation
**/README.md
**/CHANGELOG.md
**/LICENSE
**/SECURITY.md
**/TODO.md

# Package files (except root)
packages/*/package-lock.json
packages/*/yarn.lock
packages/*/pnpm-lock.yaml

# TypeScript source (compiled output will be used)
**/*.ts
!**/*.d.ts
**/tsconfig.json

# Vite config
**/vite.config.ts

# Cloudflare config
**/wrangler.jsonc
**/.wrangler/**

# Docker
**/Dockerfile
**/.dockerignore

# Environment files
**/.env
**/.env.local
**/.env.*.local

# Root config files not needed for deployment
turbo.json
.kilo/**

# Exclude other packages (we use file: references in package.json.vercel)
packages/notebooklm-api-client/**
packages/research-agent-ui/**
packages/trending-news-api/**
packages/use-voice-control/**
packages/shadcn-settings/**
packages/language-model-training/**
packages/extract-youtube/**
packages/render-url-to-html/**
packages/html-renderer-api/**
packages/legal-terms-privacy-policy/**
packages/user-help-docs/**
packages/qwksearch-mcp-server/**
packages/reason-editor/**
packages/chat-agent-toolkit/**

# Apps to exclude
apps/**

# Skills
skills/**