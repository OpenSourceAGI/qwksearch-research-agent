{
  "name": "qwksearch",
  "private": true,
  "version": "2.2.0",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev --filter=qwksearch-web",
    "build": "turbo build",
    "build:web": "turbo build --filter=qwksearch-web",
    "dev:editor": "turbo dev --filter=reason-editor",
    "build:editor": "turbo build --filter=reason-editor"
  },
  "devDependencies": {
    "turbo": "^2.10.3"
  }
}
