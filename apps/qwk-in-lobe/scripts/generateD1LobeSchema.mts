/**
 * Writes migrations/d1/0005_lobehub_tables.sql: LobeHub's tables (users,
 * settings, agents, sessions, topics, messages, providers, ...) as SQLite DDL
 * for D1, generated from packages/database/src/schemas. Re-run after a schema
 * change; `bun run cf:d1:migrate` applies it.
 */
import { writeFileSync } from 'node:fs';
import { join } from 'node:path';

import { generateD1DDL } from '../packages/database/src/core/d1/ddl';
import * as schemaNs from '../packages/database/src/schemas';

const schema = ((schemaNs as any).default ?? schemaNs) as Record<string, unknown>;

const header = `-- LobeHub's tables on D1 (users, settings, agents, sessions, topics, messages,
-- providers, ...). GENERATED by scripts/generateD1LobeSchema.mts from
-- packages/database/src/schemas; do not edit by hand. Idempotent.
--
-- The Worker reaches these through the D1 driver in
-- packages/database/src/core/d1 when DATABASE_DRIVER=d1. LobeHub's \`documents\`
-- table is \`lobe_documents\` here, because QwkSearch already has \`documents\`.

`;

const out = join(import.meta.dirname, '../migrations/d1/0005_lobehub_tables.sql');
writeFileSync(out, header + generateD1DDL(schema));
console.log(`wrote ${out}`);
