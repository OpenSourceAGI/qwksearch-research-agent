{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "typeRoots": [
      "./types",
      "./node_modules/@types"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "chat-agent-toolkit": [
        "../../packages/agent-toolkit/src/index.ts"
      ],
      "chat-agent-toolkit/*": [
        "../../packages/agent-toolkit/src/*"
      ],
      "extract-webpage": [
        "../../packages/extract-webpage/src/index.ts"
      ],
      "extract-webpage/*": [
        "../../packages/extract-webpage/src/*"
      ]
    },
    "target": "ES2018"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "types/**/*.d.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
