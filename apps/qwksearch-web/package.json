{
  "name": "qwksearch-web",
  "description": "Search, extract, vectorize, outline graph, and monitor the web for topic keywords",
  "version": "2.5.0",
  "author": "vtempest",
  "license": "rights.institute/prosper",
  "type": "module",
  "scripts": {
    "dev": "npx open-ready next dev",
    "prebuild": "cd ../../packages/shadcn-app-dock && bun run build",
    "build": "vinext build",
    "deploy": "vinext deploy",
    "start": "next start",
    "dev:cf": "vinext build && npx wrangler dev --local",
    "preview": "NODE_OPTIONS='--max-old-space-size=4096' next build && next start",
    "deploy:staging": "NODE_OPTIONS='--max-old-space-size=4096' vinext build && vinext deploy --env staging",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:push:d1": "drizzle-kit push --config drizzle.d1.config.ts",
    "db:migrate:d1": "for f in drizzle/*.sql; do echo ''; wrangler d1 execute qwksearch-new --remote --file=$f; done",
    "db:studio": "drizzle-kit studio",
    "db:create": "bun x create cloud-db",
    "analyze": "ANALYZE=true next build --webpack",
    "favicon": "bun create favicon public/favicon-512.png public/ --overwrite",
    "validate:openrouter": "tsx scripts/validate-openrouter-models.ts",
    "validate:openrouter:json": "tsx scripts/validate-openrouter-models.ts --json",
    "validate:nvidia": "tsx scripts/validate-nvidia-models.ts",
    "validate:nvidia:json": "tsx scripts/validate-nvidia-models.ts --json",
    "test:validation": "tsx scripts/test-validation.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
