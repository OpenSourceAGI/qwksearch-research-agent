{
  "name": "qwksearch-web",
  "description": "Search, extract, vectorize, outline graph, and monitor the web for topic keywords",
  "version": "2.5.0",
  "author": "vtempest",
  "license": "rights.institute/PROSPER",
  "type": "module",
  "scripts": {
    "dev": "npx open-ready next dev",
    "prebuild": "cd ../../packages/extract-pdf && bun run build && cd ../shadcn-app-dock && bun run build && cd ../shadcn-settings && bun run build && cd ../react-weather-forecast && bun run build && cd ../chat-agent-toolkit && bun run build && cd ../research-agent-ui && bun run build",
    "build": "vinext build",
    "deploy": "vinext deploy",
    "start": "next start",
    "dev:cf": "vinext build && npx wrangler dev --local",
    "preview": "NODE_OPTIONS='--max-old-space-size=4096' next build && next start",
    "deploy:staging": "NODE_OPTIONS='--max-old-space-size=4096' vinext build && vinext deploy --env staging",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push --config drizzle.d1.config.ts",
    "db:migrate": "for f in drizzle/*.sql; do echo ''; wrangler d1 execute qwksearch-new --remote --file=$f; done",
    "db:studio": "drizzle-kit studio",
    "db:create": "bun x create cloud-db",
    "analyze": "ANALYZE=true next build --webpack",
    "favicon": "bun create favicon public/favicon-512.png public/ --overwrite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^3.0.0",
