{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "typeRoots": [
      "./types",
      "./node_modules/@types"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "chat-agent-toolkit": [
        "../../packages/chat-agent-toolkit/src/index.ts"
      ],
      "chat-agent-toolkit/*": [
        "../../packages/chat-agent-toolkit/src/*"
      ],
      "research-agent-ui": [
        "../../packages/research-agent-ui/src/index.ts"
      ],
      "research-agent-ui/*": [
        "../../packages/research-agent-ui/src/*"
      ],
      "search-web-api": [
        "../../packages/search-web-api/src/index.ts"
      ],
      "search-web-api/*": [
        "../../packages/search-web-api/src/*"
      ],
      "trending-news-api": [
        "../../packages/trending-news-api/src/index.ts"
      ],
      "trending-news-api/*": [
        "../../packages/trending-news-api/src/*"
      ],
      "write-language": [
        "../../packages/write-language/src/index.ts"
      ],
      "write-language/*": [
        "../../packages/write-language/src/*"
      ],
      "user-help-docs": [
        "../../packages/user-help-docs/src/index.ts"
      ],
      "user-help-docs/*": [
        "../../packages/user-help-docs/src/*"
      ],
      "qwksearch-api-client": [
        "../../packages/qwksearch-api-client/src/index.ts"
      ],
      "qwksearch-api-client/*": [
        "../../packages/qwksearch-api-client/src/*"
      ],
      "extract-pdf": [
        "../../packages/extract-pdf/src/pdf-to-html.ts"
      ],
      "extract-webpage": [
        "../../packages/extract-webpage/src/index.ts"
      ],
      "extract-webpage/*": [
        "../../packages/extract-webpage/src/*"
      ]
    },
    "target": "ES2018"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
