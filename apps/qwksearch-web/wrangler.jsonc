{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qwksearch",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],
    "upload_source_maps": true,
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "images": {
    "binding": "IMAGES",
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "c53d894414bb4cfda42536c717095d40",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qwksearch-new",
      "database_id": "b0ba9a66-e256-43dd-9083-062977c282a4",
    },
  ],
  "env": {
    "production": {
      "keep_vars": true,
      "images": {
        "binding": "IMAGES",
      },
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "371c242bebfc4de78ed9841ce72c77b3",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "qwksearch-new",
          "database_id": "b0ba9a66-e256-43dd-9083-062977c282a4",
        },
      ],
    },
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
