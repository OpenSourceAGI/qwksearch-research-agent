
# -------------------- Database --------------------
# Local SQLite file for dev (D1 binding is used in production via wrangler.jsonc)
DATABASE_URL=file:./data/qwksearch.db

# -------------------- Authentication --------------------
# Better-Auth secret key (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-secret-key-here

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Required for Google Sign-In and Google One Tap
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Application Base URL (required for OAuth callbacks)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Better Auth base URL (must match NEXT_PUBLIC_BASE_URL; required for OAuth redirect URIs)
BETTER_AUTH_URL=http://localhost:3000

# Optional OAuth Providers
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Email Authentication (uses Cloudflare Email Service via MailChannels)
# No API key needed - works automatically on Cloudflare Workers
# Make sure to configure SPF records for your domain

# -------------------- AI Provider APIs --------------------
# ===== DEFAULT FREE PROVIDERS (RECOMMENDED FOR ALL USERS) =====

# OpenRouter (https://openrouter.ai/settings/keys) - PRIMARY DEFAULT
# Default model: openrouter/free (200K context)
# Free tier - NO DAILY LIMITS: $0 per 1M input/output tokens
# Available free models:
#   - openrouter/free (200K context)
#   - nvidia/nemotron-3-super-120b-a12b:free (128K context)
#   - qwen/qwen3-coder:free (32K context)
#   - deepseek/deepseek-v4-flash:free (64K context)
#   - google/gemma-4-31b-it:free (131K context)
#   - z-ai/glm-4.5-air:free (128K context)
OPENROUTER_API_KEY=

# Groq (https://console.groq.com/keys) - SECONDARY DEFAULT
# Default model: llama-3.3-70b-versatile (fastest inference)
# Free tier limits per day (calculated as TPM × 60 × 24):
#   - llama-3.3-70b-versatile: 300K TPM / 1K RPM = ~432M tokens/day
#   - llama-3.1-8b-instant: 250K TPM / 1K RPM = ~360M tokens/day
#   - llama-4-scout-17b: 300K TPM / 1K RPM = ~432M tokens/day
#   - qwen/qwen3-32b: 300K TPM / 1K RPM = ~432M tokens/day
#   - openai/gpt-oss-120b: 250K TPM / 1K RPM = ~360M tokens/day
#   - groq/compound: 200K TPM / 200 RPM = ~288M tokens/day
GROQ_API_KEY=

# ===== ADDITIONAL FREE PROVIDERS =====
# NVIDIA NIM (https://build.nvidia.com/settings/api-keys)
# Free tier: Nemotron 3 Super 120B, Kimi K2.5 (256K context), DeepSeek V3 (1M context)
# Default model: nvidia/llama-nemotron-3-super-120b-a12b
NVIDIA_API_KEY=

# ===== PREMIUM MODELS (OPTIONAL) =====
# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Google AI (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=

# -------------------- Search & Data APIs --------------------
# Tavily Search API (https://tavily.com)
TAVILY_API_KEY=


# -------------------- Search Engine --------------------
# SearxNG instance URL (optional - uses public instance if not set)
SEARXNG_API_URL=http://localhost:4000

# -------------------- Cloudflare Browser Rendering (Scraper) --------------------
# Cloudflare Puppeteer scraper service for JavaScript-heavy sites
# Deploy from packages/render-url-to-html/scraper-cloudflare/
SCRAPER_URL=https://scraper-cloudflare.your-subdomain.workers.dev
SCRAPER_API_KEY=

# -------------------- Cloudflare R2 Storage --------------------
# Get credentials from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_UPLOADS_BUCKET=qwksearch-uploads
