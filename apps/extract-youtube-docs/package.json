{
  "name": "extract-youtube-docs",
  "description": "Documentation site for the extract-youtube npm package (Fumadocs on vinext, deployed to Cloudflare Workers)",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "rights.institute/PROSPER",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSourceAGI/qwksearch-research-agent.git",
    "directory": "apps/extract-youtube-docs"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "deploy": "vinext build && wrangler deploy",
    "preview": "wrangler dev",
    "typegen": "vinext typegen && bun -e \"await (await import('fumadocs-mdx/vite')).postInstall()\"",
    "typecheck": "bun run typegen && tsc --noEmit"
  },
  "//zod": "Pinned to fumadocs-mdx's own zod range so fumadocs-core resolves one zod, and so one copy of itself: with two, the loader's page types stop matching the generated collection's.",
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.15.17",
    "fumadocs-mdx": "^15.4.5",
    "fumadocs-ui": "^16.15.17",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-rsc": "^0.5.35",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vinext": "1.0.0",
    "vite": "^8.2.2",
    "wrangler": "^4.144.0"
  }
}
