{
  "name": "extract-youtube",
  "version": "1.0.414",
  "description": "Fast, no-browser serverless-optimized YouTube transcript extractor, with optional cloud-ytdl audio/video download (MP3 via ffmpeg) and a media HTTP API, with a video library admin API (D1 or in-memory) and React UI: a floating YouTube player, a synced-transcript modal, video grid/list components and library admin screens",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.cjs"
    },
    "./library": {
      "types": "./dist/library/index.d.ts",
      "import": "./dist/library/index.mjs",
      "require": "./dist/library/index.cjs"
    },
    "./download": {
      "types": "./dist/download/index.d.ts",
      "import": "./dist/download/index.mjs",
      "require": "./dist/download/index.cjs"
    }
  },
  "//bin": "Spelled out as an object with a relative path. npm normalizes the string form itself and prints a notice for it on every publish.",
  "bin": {
    "extract-youtube": "dist/cli.js"
  },
  "//files": "Publish only what consumers resolve. Without this the tarball also carries test/, jest.config.js, tsconfig*.json and vite.config.ts. Matches extract-webpage and extract-pdf.",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && npm run build:lib && npm run build:cli && npm run build:react && npm run build:library && npm run build:download && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationMap",
    "build:lib": "vite build",
    "build:cli": "BUILD_CLI=true vite build",
    "build:react": "BUILD_REACT=true vite build",
    "build:library": "BUILD_LIBRARY=true vite build",
    "build:download": "BUILD_DOWNLOAD=true vite build",
    "build:bundle": "npm run build:lib && npm run build:cli && npm run build:react && npm run build:library && npm run build:download",
    "build:legacy": "tsc",
    "ship": "npm run build && npx standard-version --release-as patch; npm publish",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:speeds": "bun src/cli.ts dQw4w9WgXcQ -f speeds",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "youtube",
    "transcript",
    "subtitles",
    "captions",
    "api",
    "serverless",
    "lambda",
    "vercel",
    "cloudflare",
    "edge",
    "typescript",
    "youtube-transcript",
    "youtube-transcript-api",
    "srt",
    "webvtt",
    "video",
    "parsing",
    "extraction",
    "optimized",
    "react",
    "floating-player",
    "picture-in-picture",
    "video-player",
    "youtube-player",
    "playlist",
    "video-library",
    "video-grid",
    "admin",
    "cloudflare-d1",
    "youtube-downloader",
    "mp3",
    "audio-extraction",
    "storybook"
  ],
  "author": "",
  "license": "rights.institute/PROSPER",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSourceAGI/qwksearch-research-agent.git",
    "directory": "packages/extract-youtube"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "html-entities": "^2.6.0",
    "https-proxy-agent": "^9.1.0",
    "grab-url": "^1.6.22",
    "youtube-transcript-api": "^3.0.6"
  },
  "//peerDependencies": "cloud-ytdl backs only the Node-only extract-youtube/download entry (audio/video download, MP3 via ffmpeg); optional so a transcript-only install stays dependency-light and Worker-safe.",
  "peerDependencies": {
    "cloud-ytdl": ">=1.0.5-next",
    "react": ">=18",
    "react-dom": ">=18",
    "lucide-react": "^0.300.0 || ^1.0.0"
  },
  "peerDependenciesMeta": {
    "cloud-ytdl": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "cloud-ytdl": "^1.0.5-next",
    "jest": "^30.5.1",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "terser": "^5.51.2",
    "ts-jest": "^29.4.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
