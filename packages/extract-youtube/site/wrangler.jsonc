{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The docs Worker's name, kept so the docs keep their URL: the demo moved
  // into it (at /demo), not the other way round.
  "name": "extract-youtube-docs",
  // Hand-written entry (worker/index.ts): the demo's /api/* first, then
  // vinext's App Router for the docs and /demo. `vinext build` bundles it
  // (through @cloudflare/vite-plugin) into dist/, and writes
  // .wrangler/deploy/config.json so `wrangler deploy` / `wrangler dev` use the
  // built output rather than this source config.
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Wrangler deletes plaintext Variables set in the Cloudflare dashboard on
  // every deploy unless keep_vars is set (this config declares no `vars`).
  // Secrets are never deleted either way. Top-level only.
  "keep_vars": true,
  "assets": {
    // Static files (the docs' bundles, the Storybook at /storybook/) are
    // served before the Worker runs; everything else reaches worker/index.ts.
    "not_found_handling": "none",
    "binding": "ASSETS"
  }
  // The demo's bindings are optional, all of them. With none set it runs as a
  // sandbox: an in-memory library per isolate that anyone can edit, reset on
  // redeploy.
  //
  //   wrangler secret put ADMIN_TOKEN      – require this bearer token to edit
  //   wrangler secret put YOUTUBE_API_KEY  – enables Resync and richer Auto-fill
  //
  // To keep the library in D1 instead, create a database and bind it as DB:
  //
  //   wrangler d1 create extract-youtube-demo
  //   "d1_databases": [{ "binding": "DB", "database_name": "extract-youtube-demo", "database_id": "<id>" }]
  //
  // The Worker creates its tables on first request. A D1-backed library with
  // no ADMIN_TOKEN is read-only, so a public deploy is never open to edits.
  //
  // youtube.js.org: the site's links assume it is served there. To attach it,
  // the zone has to be in this Cloudflare account; then add
  //   "routes": [{ "pattern": "youtube.js.org", "custom_domain": true }]
  // (a deploy fails while the zone is missing, which is why it is not set).
}
