# Vercel Environment Variables for extract-pdf demo
# Copy this to .env.local for local development, or set in Vercel dashboard

# Maximum PDF size in MB (default: 15)
MAX_PDF_MB=15

# Maximum HTML size in MB for /api/extract (default: 2)
MAX_HTML_MB=2

# Granite Docling OCR processor URL (optional)
# Get this from a Hugging Face Space running the Docling processor
# DOCLING_PROCESSOR_URL=https://your-username-extract-pdf-docling.hf.space

# Docling API token (optional, required if DOCLING_PROCESSOR_URL is set)
# This should match the DOCLING_API_TOKEN secret in your Hugging Face Space
# DOCLING_API_TOKEN=your-docling-api-token

# Hugging Face read token (optional, for private Spaces)
# HF_SPACE_TOKEN=hf_your-read-token

# Docling OCR tuning (optional)
# DOCLING_MAX_PAGES=10
# DOCLING_MAX_TOKENS=1500
# DOCLING_MAX_IMAGE_MB=8