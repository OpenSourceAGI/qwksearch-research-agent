{
  "name": "qwksearch-api-client",
  "version": "0.0.13",
  "description": "QwkSearch API Client - Generated from openapi-docs.yml",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenSourceAGI/qwksearch-research-agent",
    "directory": "packages/qwksearch-api-client"
  },
  "type": "module",
  "main": "./dist/api-client.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/api-client.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/api-client.js",
      "require": "./dist/api-client.umd.cjs"
    }
  },
  "scripts": {
    "ship": "npx standard-version --release-as patch; npm publish",
    "build:api": "API_URL=https://app.qwksearch.com/api openapi-ts && vite build",
    "test:api": "vitest"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@hey-api/client-fetch": "^0.13.1",
    "@hey-api/openapi-ts": "^0.88.0",
    "@hey-api/vite-plugin": "^0.2.0",
    "terser": "^5.44.1",
    "vite-plugin-dts": "^5.0.3",
    "vite": "^8.1.3"
  }
}
