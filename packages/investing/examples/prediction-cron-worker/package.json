{
  "name": "investing-prediction-cron-worker",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker cron agent: hourly Polymarket mover scan with AI analysis and Discord/Slack alerts.",
  "scripts": {
    "start": "tsx src/run-once.ts",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "investing": "latest",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.162.0"
  }
}
