# AWS Fargate GPU-optimized Dockerfile
# Supports GPU instances with CUDA acceleration

FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

LABEL maintainer="Transformer Training Demo"
LABEL description="Transformer language model training with GPU acceleration for AWS Fargate"
LABEL version="2.0"
LABEL gpu-support="true"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PORT=8080 \
    CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:${PATH} \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-dev \
    python3-pip \
    build-essential \
    git \
    curl \
    ca-certificates \
    aria2 \
    bzip2 \
    lbzip2 \
    htop \
    vim \
    nvidia-utils \
    nvidia-compute-utils \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Make python3.11 the default
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

RUN groupadd -r transformer && useradd -r -g transformer transformer

WORKDIR /app

RUN mkdir -p /app/logs /app/checkpoints /app/data \
    && chown -R transformer:transformer /app

COPY config/requirements.txt .

RUN pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu124 && \
    pip install --no-cache-dir boto3 numpy requests

COPY src/ ./src/
COPY scripts/ ./scripts/
COPY README.md .

RUN chmod +x /app/scripts/*.sh

RUN chown -R transformer:transformer /app

USER transformer

CMD ["uvicorn", "src.services.server:app", "--host", "0.0.0.0", "--port", "8080"]

EXPOSE 8080
EXPOSE 8888

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

LABEL com.example.training-type="transformer"
LABEL com.example.framework="tinygrad"
LABEL com.example.gpu-support="true"
LABEL com.example.gpu-memory="16GB-48GB"
