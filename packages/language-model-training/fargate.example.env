# AWS Fargate Configuration for train-next-word-prediction

# ============================================================================
# AWS Configuration
# ============================================================================
AWS_REGION=us-east-1
AWS_PROFILE=default

# IAM Credentials (load from AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY env vars)
# Or use AWS CLI credentials in ~/.aws/credentials

# ============================================================================
# ECS Configuration
# ============================================================================
CLUSTER_NAME=transformer-training
SERVICE_NAME=train-next-word-prediction
TASK_FAMILY=train-next-word-prediction
CONTAINER_NAME=train-next-word-prediction

# ============================================================================
# Compute Configuration
# ============================================================================
# Options: 'cpu' (cheap), 'gpu' (premium), 'gpu-spot' (cheapest GPU)
COMPUTE_TYPE=cpu

# CPU and Memory (must be valid Fargate combinations)
# CPU: 256, 512, 1024, 2048, 4096
# Memory: depends on CPU (see AWS docs)
CPU_UNITS=1024
MEMORY_MB=2048

# GPU Configuration (only used if COMPUTE_TYPE=gpu or gpu-spot)
GPU_COUNT=1

# ============================================================================
# Cost Optimization
# ============================================================================
# Use cheaper Fargate Spot instances (up to 70% discount, but interruptible)
USE_FARGATE_SPOT=false

# Number of tasks to run
DESIRED_COUNT=1

# ============================================================================
# Storage Configuration
# ============================================================================
# S3 for checkpoints and training data
S3_BUCKET=my-transformer-bucket
S3_PREFIX=transformer-training

# EFS for persistent storage across tasks
ENABLE_EFS=false
EFS_ID=fs-12345678

# ============================================================================
# Networking Configuration
# ============================================================================
# VPC Subnets (comma-separated)
TASK_SUBNETS=subnet-12345678,subnet-87654321

# Security Groups (comma-separated)
TASK_SECURITY_GROUPS=sg-12345678

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_GROUP=/ecs/transformer-training
LOG_STREAM=train-next-word-prediction

# ============================================================================
# Model Configuration
# ============================================================================
# Use demo data for testing (true) or full Wikipedia (false)
USE_DEMO_MODE=true

# MongoDB connection
MONGO_HOST=mongodb.example.com
MONGO_PORT=27017

# Paths inside container
MODEL_CHECKPOINT_PATH=/data/checkpoints
DATA_PATH=/data

# ============================================================================
# Cost Optimization Presets
# ============================================================================
# CPU Only (Minimal Cost)
# COMPUTE_TYPE=cpu
# CPU_UNITS=256
# MEMORY_MB=512
# USE_FARGATE_SPOT=false

# CPU Medium (Low Cost)
# COMPUTE_TYPE=cpu
# CPU_UNITS=1024
# MEMORY_MB=2048
# USE_FARGATE_SPOT=true

# GPU with Spot (Medium Cost)
# COMPUTE_TYPE=gpu-spot
# CPU_UNITS=4096
# MEMORY_MB=30720
# GPU_COUNT=1
# USE_FARGATE_SPOT=true

# GPU with Reserved Instances (Higher Cost, Guaranteed)
# COMPUTE_TYPE=gpu
# CPU_UNITS=4096
# MEMORY_MB=30720
# GPU_COUNT=4
# USE_FARGATE_SPOT=false
