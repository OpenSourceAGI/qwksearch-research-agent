# Local development secrets for Cloudflare Workers
# Copy to .env and fill in values (never commit .env)
# These are used by wrangler dev for local testing

# Admin token for Web Console and admin API access
OOMOL_CONNECT_ADMIN_TOKEN=local-dev-token-change-me

# Encryption key for credentials (DO NOT LOSE — cannot recover if lost)
OOMOL_CONNECT_ENCRYPTION_KEY=local-dev-key-change-me
