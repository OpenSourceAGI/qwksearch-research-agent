{
  "name": "research-agent-ui",
  "description": "The QwkSearch app UI: conversation window, article reader, search config, file uploads, chat history, and the app shell — exported both with and without the REASON editor and its sidebar",
  "version": "0.1.321",
  "author": "vtempest",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSourceAGI/qwksearch-research-agent.git",
    "directory": "packages/research-agent-ui"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.mjs",
      "require": "./dist/workspace.cjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.mjs",
      "require": "./dist/config.cjs"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api.mjs",
      "require": "./dist/api.cjs"
    },
    "./file-sources": {
      "types": "./src/lib/file-sources.ts",
      "import": "./src/lib/file-sources.ts"
    },
    "./google-drive": {
      "types": "./src/lib/google-drive-source.ts",
      "import": "./src/lib/google-drive-source.ts"
    },
    "./chunk-error-reload": {
      "types": "./src/app/useChunkErrorReload.ts",
      "import": "./src/app/useChunkErrorReload.ts"
    },
    "./settings": {
      "types": "./src/settings/index.ts",
      "import": "./src/settings/index.ts"
    },
    "./settings/*": {
      "import": "./src/settings/*"
    }
  },
  "files": [
    "dist",
    "src/settings",
    "src/app/useChunkErrorReload.ts",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/workspace.mjs",
    "./dist/workspace.cjs"
  ],
  "scripts": {
    "build": "vite build && tsc --project tsconfig.build.json",
    "build:cloudflare": "tsc src/cloudflare/worker.ts --outDir dist/cloudflare --declaration --module esnext --target esnext --lib esnext --moduleResolution node",
    "dev:cloudflare": "npm run build:cloudflare && wrangler dev --config wrangler.local.jsonc",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy --config wrangler.local.jsonc",
    "type-check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "bun run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "chat",
    "research-agent",
    "search",
    "article-reader",
    "shadcn",
    "react"
  ],
  "//peerDependencies": "react-reason-editor and react-reason-editor-sidebar back the ./workspace export but are deliberately not peers. Naming a sibling workspace package as a peer makes bun install non-convergent — it reads the merged peer+dev entry back differently than it writes it, so `bun install --frozen-lockfile` reports \"lockfile had changes\" however freshly bun.lock was generated. They stay workspace:* devDependencies, which is also what keeps turbo building them before this package.",
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "ai": "^7.0.159",
    "chat-agent-toolkit": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.4",
    "extract-webpage": "workspace:*",
    "grab-url": "^3.0.9",
    "html2canvas": "^1.4.1",
    "kokoro-js": "^1.2.1",
    "legal-terms-privacy-policy": "workspace:*",
    "lucide-react": "^1.66.0",
    "markdown-to-jsx": "^9.10.4",
    "motion": "^14.9.0",
    "quantum-sphere-loading-icon": "^1.0.6",
    "qwksearch-api-client": "workspace:*",
    "react-icons": "^5.7.0",
    "react-native-app-buttons": "^0.1.4",
    "react-textarea-autosize": "^8.5.9",
    "search-web-api": "workspace:*",
    "shadcn-app-dock": "workspace:*",
    "shadcn-theme-menu": "^1.1.74",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "trending-news-api": "workspace:*",
    "education-playlists": "workspace:*",
    "turndown": "^7.2.4",
    "use-voice-control": "^0.1.235",
    "use-weather-forecast": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "itty-router": "^5.0.24",
    "jsdom": "^30.1.3",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-reason-editor": "workspace:*",
    "react-reason-editor-sidebar": "workspace:*",
    "search-autocomplete": "workspace:*",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.1"
  },
  "license": "rights.institute/PROSPER"
}
