{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "train-next-word-prediction",
  "main": "worker/index.ts",
  "compatibility_date": "2025-05-01",

  // The Worker is just a thin HTTP proxy in front of the container below -
  // every request is forwarded to the FastAPI control API (src/server.py)
  // that the Dockerfile runs by default.
  "containers": [
    {
      "class_name": "TrainingContainer",
      "image": "./Dockerfile",
      "max_instances": 2,
      // "dev" is the smallest tier (256MB/2GB disk) and is enough for the
      // micrograd demo and the control API itself. Bump to "standard" (or
      // whatever the current largest tier is named) if you also want to run
      // small, demo-mode transformer training inside the container - see
      // the capacity note in README.md before doing that.
      "instance_type": "dev"
    }
  ],

  // Containers are addressed through a Durable Object so each container
  // instance has a stable identity Wrangler can route to.
  "durable_objects": {
    "bindings": [
      {
        "class_name": "TrainingContainer",
        "name": "TRAINING_CONTAINER"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TrainingContainer"]
    }
  ],

  "dev": {
    "port": 8787
  }
}
